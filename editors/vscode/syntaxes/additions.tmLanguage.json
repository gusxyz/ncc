{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Novolang additions",
  "scopeName": "novolang.additions",
  "injectionSelector": "L:source.novolang - string - comment",
  "patterns": [
    {
      "name": "meta.import.novolang",
      "begin": "(#import)(?![A-Za-z0-9_])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.novolang"
        }
      },
      "end": "(?=\\r?$)",
      "patterns": [
        {
          "name": "string.quoted.double.import.novolang",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.novolang"
            }
          },
          "end": "\"|(?=\\r?$)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.novolang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.novolang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s*)(::)(\\s*)(struct)\\b",
      "captures": {
        "1": {
          "name": "entity.name.type.novolang"
        },
        "3": {
          "name": "keyword.operator.declaration.constant.novolang"
        },
        "5": {
          "name": "storage.type.struct.novolang"
        }
      }
    },
    {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*((?:int|char|u8|i8|i16|u16|i32|u32|i64|u64))\\b",
      "captures": {
        "1": {
          "name": "entity.name.type.novolang"
        },
        "2": {
          "name": "keyword.operator.declaration.constant.novolang"
        },
        "3": {
          "name": "storage.type.novolang"
        }
      }
    },
    {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:\\*|\\[))",
      "captures": {
        "1": {
          "name": "entity.name.type.novolang"
        },
        "2": {
          "name": "keyword.operator.declaration.constant.novolang"
        },
        "3": {
          "name": "entity.name.type.novolang"
        }
      }
    },
    {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
      "captures": {
        "1": {
          "name": "entity.name.constant.novolang"
        },
        "2": {
          "name": "keyword.operator.declaration.constant.novolang"
        }
      }
    },
    {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:=)",
      "captures": {
        "1": {
          "name": "variable.other.definition.novolang"
        },
        "2": {
          "name": "keyword.operator.declaration.inferred.novolang"
        }
      }
    },
    {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?![:=])\\s*(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "variable.other.definition.novolang"
        },
        "2": {
          "name": "punctuation.separator.type.novolang"
        },
        "3": {
          "name": "storage.type.struct.novolang"
        },
        "4": {
          "name": "entity.name.type.novolang"
        }
      }
    },
    {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?![:=])\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "variable.other.definition.novolang"
        },
        "2": {
          "name": "punctuation.separator.type.novolang"
        },
        "3": {
          "name": "storage.type.novolang"
        }
      }
    },
    {
      "match": "\\bsizeof\\b",
      "name": "keyword.operator.sizeof.novolang"
    },
    {
      "match": "\\bsyscall\\b(?=\\s*\\()",
      "name": "support.function.builtin.novolang"
    },
    {
      "match": "\\b(?:int|char|u8|i8|i16|u16|i32|u32|i64|u64)\\b",
      "name": "storage.type.novolang"
    },
    {
      "match": "(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\*+)\\s*(\\))",
      "captures": {
        "1": {
          "name": "punctuation.section.parens.begin.novolang"
        },
        "2": {
          "name": "entity.name.type.novolang"
        },
        "3": {
          "name": "keyword.operator.pointer.novolang"
        },
        "4": {
          "name": "punctuation.section.parens.end.novolang"
        }
      }
    },
    {
      "match": "&&|\\|\\||!(?!=)",
      "name": "keyword.operator.logical.novolang"
    },
    {
      "match": "::|:=",
      "name": "keyword.operator.declaration.novolang"
    }
  ]
}
